        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml database_diagram\n!define pk(x) &lt;b&gt;&lt;color:#b8861b&gt;&lt;&amp;key&gt;&lt;/color&gt; x&lt;/b&gt;\n!define fk(x) &lt;color:#666666&gt;&lt;&amp;link-intact&gt;&lt;/color&gt; x\ntitle DVD Rental App - Database Entity Relationship Diagram\n\nentity \&quot;users\&quot; as users {\n  pk(id) : INTEGER\n  --\n  email : STRING &lt;&lt;unique&gt;&gt;\n  password_hash : STRING\n  first_name : STRING\n  last_name : STRING\n  phone_number : STRING\n  billing_address_line1 : STRING\n  billing_address_line2 : STRING\n  billing_city : STRING\n  billing_state : STRING\n  billing_postal_code : STRING\n  is_active : BOOLEAN\n  created_at : DATETIME\n  updated_at : DATETIME\n}\n\nentity \&quot;password_history\&quot; as password_history {\n  pk(id) : INTEGER\n  --\n  fk(user_id) : INTEGER\n  password_hash : STRING\n  created_at : DATETIME\n}\n\nentity \&quot;payment_methods\&quot; as payment_methods {\n  pk(id) : INTEGER\n  --\n  fk(user_id) : INTEGER\n  payment_token : STRING &lt;&lt;unique&gt;&gt;\n  card_brand : STRING\n  card_last4 : STRING\n  card_exp_month : INTEGER\n  card_exp_year : INTEGER\n  is_default : BOOLEAN\n  created_at : DATETIME\n  updated_at : DATETIME\n}\n\nentity \&quot;dvds\&quot; as dvds {\n  pk(id) : INTEGER\n  --\n  title : STRING\n  director : STRING\n  genre : STRING\n  release_year : INTEGER\n  description : TEXT\n  rental_price_cents : INTEGER\n  total_copies : INTEGER\n  available_copies : INTEGER\n  is_active : BOOLEAN\n  created_at : DATETIME\n  updated_at : DATETIME\n}\n\nentity \&quot;shopping_carts\&quot; as shopping_carts {\n  pk(id) : INTEGER\n  --\n  fk(user_id) : INTEGER\n  status : STRING &lt;&lt;active|converted|abandoned&gt;&gt;\n  created_at : DATETIME\n  updated_at : DATETIME\n}\n\nentity \&quot;shopping_cart_items\&quot; as shopping_cart_items {\n  pk(id) : INTEGER\n  --\n  fk(cart_id) : INTEGER\n  fk(dvd_id) : INTEGER\n  quantity : INTEGER\n  unit_price_cents : INTEGER\n  created_at : DATETIME\n  updated_at : DATETIME\n}\n\nentity \&quot;orders\&quot; as orders {\n  pk(id) : INTEGER\n  --\n  fk(user_id) : INTEGER\n  fk(payment_method_id) : INTEGER\n  order_date : DATETIME\n  subtotal_cents : INTEGER\n  tax_cents : INTEGER\n  total_cents : INTEGER\n  status : STRING &lt;&lt;pending|placed|cancelled&gt;&gt;\n  created_at : DATETIME\n  updated_at : DATETIME\n}\n\nentity \&quot;order_items\&quot; as order_items {\n  pk(id) : INTEGER\n  --\n  fk(order_id) : INTEGER\n  fk(dvd_id) : INTEGER\n  quantity : INTEGER\n  unit_price_cents : INTEGER\n  total_price_cents : INTEGER\n  created_at : DATETIME\n}\n\nusers ||--o{ password_history : \&quot;ON DELETE CASCADE\&quot;\nusers ||--o{ payment_methods : \&quot;ON DELETE CASCADE\&quot;\nusers ||--o{ shopping_carts : \&quot;ON DELETE CASCADE\&quot;\nusers ||--o{ orders : \&quot;ON DELETE RESTRICT\&quot;\npayment_methods ||--o{ orders : \&quot;ON DELETE RESTRICT\&quot;\nshopping_carts ||--o{ shopping_cart_items : \&quot;ON DELETE CASCADE\&quot;\ndvds ||--o{ shopping_cart_items : \&quot;ON DELETE RESTRICT\&quot;\ndvds ||--o{ order_items : \&quot;ON DELETE RESTRICT\&quot;\norders ||--o{ order_items : \&quot;ON DELETE CASCADE\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TTeTKJQYTEUmevwNoXmt-1">
